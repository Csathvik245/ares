  ],
  "routes": 31,
  "km": 15.38
 },
 "features": [
  {
   "id": "log_walk_time",
   "about": "log of walking time per meter from the Contract 2 model divided by the time on flat firm ground; its weight a is a power: walk_time^a"
  },
  {
   "id": "slope_over_8",
   "about": "Slope above 8 degrees: max(0, slope - 8) / 10"
  },
  {
   "id": "slope_over_15",
   "about": "Slope above 15 degrees: max(0, slope - 15) / 10"
  },
  {
   "id": "roughness",
   "about": "Ground roughness (rock layer) / 0.2"
  },
  {
   "id": "soft_sand",
   "about": "1 if thermal inertia is under 175 (soft sand), else 0"
  },
  {
   "id": "loose_ground",
   "about": "How loose the ground is: (250 - thermal inertia) / 75, clipped to 0..1"
  },
  {
   "id": "near_no_go",
   "about": "1 if a no-go cell is within 2 cells (about 50 m), else 0"
  }
 ],
 "costModel": "cost per meter = walk_time^a x exp(sum of v x feature); physics model = (a = 1, every v = 0)",
 "training": {
  "method": "Exponentiated maximum margin planning (Ratliff, Bagnell & Zinkevich 2006; Ratliff, Silver & Bagnell 2009): subgradient steps with loss-augmented Dijkstra, weights averaged over iterations",
  "routeLengthM": 500,
  "minStraightness": 0.6,
  "iterations": 150,
  "step": 0.1,
  "maxStep": 0.2,
  "regularization": 0.1,
  "margin": 0.1,
  "lossRadiusM": 37.5,
  "prior": "walking time only (the physics model)",
  "dropped": {
   "wandering": 9,
   "no_go": 0,
   "short": 0
  },
  "safetyRule": "learned_safe: hazard weights >= 0 and walking-time power >= 1 (never less careful than physics)",
  "modelSelection": "every 10 iterations, keep the averaged weights with the smallest mean distance from the experts' routes on the TRAINING routes (iteration 0 = physics model)",
  "demoCleanup": "rover path rasterized to the grid, loops removed, staircase corners removed (taut)"
 },
